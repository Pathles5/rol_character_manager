{
  "name": "fichass",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-manifest.mjs",
    "build": "tsc && vite build",
    "build:backend": "esbuild backend/session.ts --bundle --platform=node --target=node22 --format=esm --outfile=backend/dist/index.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "powershell -ExecutionPolicy Bypass -File scripts/check.ps1"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1175.0",
    "@aws-sdk/lib-dynamodb": "^3.1175.0",
    "@fontsource/inter": "^5.1.0",
    "@types/node": "^26.6.6",
    "eslint": "^9.15.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
